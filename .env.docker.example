# Used only by the local Docker Compose profile
APP_PORT=8080
APP_BIND_IP=127.0.0.1

# Local browser origin. Set this to the public HTTPS origin in Coolify.
APP_ORIGIN=http://localhost:8080

# Build-time frontend API path. Keep /api when using the included Caddy gateway.
VITE_API_URL=/api

# Generate a private secret before deploying, for example: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h

# Initial administrator. Keep the password in this ignored .env file or Coolify secrets.
ADMIN_NAME=Administração
ADMIN_EMAIL=admin@reconectati.local
ADMIN_PASSWORD=change-this-admin-password
